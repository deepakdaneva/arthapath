# ArthaPath environment template. Copy to .env.local and fill in.
# Placeholders only. Never commit real values.
#
# Firebase web config values are public identifiers, not secrets
# (security comes from Auth + Firestore rules), but keep them out of
# git anyway so each deployer uses their own projects.

FIREBASE_PROJECT_ID_UAT=your-uat-project-id
FIREBASE_PROJECT_ID_PROD=your-prod-project-id

FIREBASE_API_KEY=replace-me
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_APP_ID=replace-me
FIREBASE_MESSAGING_SENDER_ID=replace-me

# AI provider keys are NOT configured here. ArthaPath is bring-your-own-key:
# each user enters their own keys inside the app, where they are encrypted
# on-device before being stored.
