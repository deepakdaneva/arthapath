{
  "name": "arthapath",
  "version": "1.0.0",
  "scripts": {
    "config": "node scripts/write-app-config.mjs",
    "prestart": "npm run config",
    "start": "ng serve",
    "prebuild": "npm run config",
    "build": "ng build",
    "pretest": "npm run config",
    "test": "ng test",
    "lint": "ng lint",
    "emulators": "firebase emulators:start --project demo-arthapath",
    "test:rules": "npm --prefix firebase/rules-tests test",
    "cap:sync": "npm run build && cap sync",
    "test:integration": "npm run config && firebase emulators:exec --only auth,firestore --project demo-arthapath \"ng test --watch=false\"",
    "test:e2e": "npm run config && firebase emulators:exec --only auth,firestore --project demo-arthapath \"playwright test\"",
    "screenshots": "npm run config && firebase emulators:exec --only auth,firestore --project demo-arthapath \"playwright test --config playwright.screenshots.config.ts\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@ionic/angular": "^9.0.10",
    "echarts": "^6.1.0",
    "firebase": "^13.2.0",
    "hash-wasm": "^4.12.0",
    "ionicons": "^8.1.0",
    "marked": "^18.1.3",
    "pdfjs-dist": "~6.4.299",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
