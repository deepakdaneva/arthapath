<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch animation (Android 12+ splash screen): the trend line draws itself,
  then the highlight point pops in. Older Android shows the finished icon.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="288"
            android:viewportHeight="288">
            <group android:translateX="41.6" android:translateY="41.6" android:scaleX="3.2" android:scaleY="3.2">
                <path
                    android:name="line"
                    android:pathData="M14,46 L28,30 L36,38 L50,20"
                    android:strokeColor="#14B8A6"
                    android:strokeWidth="6"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:trimPathEnd="0" />
                <group android:name="dot" android:pivotX="50" android:pivotY="20" android:scaleX="0" android:scaleY="0">
                    <path
                        android:pathData="M46,20 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0"
                        android:fillColor="#5EEAD4" />
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="line">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="650"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="dot">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="250"
                    android:startOffset="600"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="250"
                    android:startOffset="600"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
